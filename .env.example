# Environment variables for Pro-STO Mobile Contractors (React Native CLI)
#
# Copy to local env file:
#   cp .env.example .env
#
# iOS Release / TestFlight uses .env.production (currently the dev API).
# Android release can use the same file:
#   ENVFILE=.env.production npm run android -- --mode=release

# API base URL (dev/staging/prod)
API_BASE_URL=https://dev.prosto-app.ru

# Sentry / GlitchTip DSN (организация pro-sto, проект mobile-contractor)
SENTRY_DSN=https://75325edf82724f428f0565822b129fd9@sentry.zolkin.dev/8
#
# iOS Simulator "Network request failed" to external HTTPS (Safari OK):
#   npm run dev:api-proxy
#   API_BASE_URL=http://127.0.0.1:8765
# Then restart Metro (npm start) and reload the app.
